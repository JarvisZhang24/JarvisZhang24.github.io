---
import { formatDate, postPath, readingMinutes, type Post } from "../data/blog";
import type { PageContent } from "../data/site";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  content: PageContent;
  posts: Post[];
  alternatePath: string;
}

const { content, posts, alternatePath } = Astro.props;
---

<SiteHeader content={content} alternatePath={alternatePath} />

<main id="main">
  <header class="page-head">
    <div class="page-head__field" aria-hidden="true"></div>
    <p class="mono-label page-head__kicker">{content.profile.name}</p>
    <h1 class="page-head__title">{content.blog.title}</h1>
    <p class="page-head__lead">{content.blog.lead}</p>
  </header>

  {
    posts.length === 0 ? (
      <p class="empty-note">{content.blog.empty}</p>
    ) : (
      <ol class="post-list">
        {posts.map((post) => (
          <li class="post-item" data-reveal>
            <a href={postPath(post, content.locale)}>
              <time
                class="mono-label post-item__date"
                datetime={post.data.date.toISOString()}
              >
                {formatDate(post.data.date, content.locale)}
              </time>

              <div class="post-item__body">
                <h2 class="post-item__title">
                  {post.data.title}
                  {post.data.draft && (
                    <span class="badge">{content.blog.draftLabel}</span>
                  )}
                </h2>
                <p class="post-item__summary">{post.data.description}</p>
                <p class="mono-label post-item__meta">
                  {readingMinutes(post.body)} {content.blog.minutesLabel}
                </p>
                {post.data.tags.length > 0 && (
                  <ul class="tags">
                    {post.data.tags.map((tag) => (
                      <li class="tag">{tag}</li>
                    ))}
                  </ul>
                )}
              </div>

              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</main>

<SiteFooter content={content} />
