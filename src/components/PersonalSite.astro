---
import type { PageContent } from "../data/site";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
---

<SiteHeader content={content} />

<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="hero__eyebrow hero-enter hero-enter--1">{content.hero.eyebrow}</p>
      <h1 class="hero__name hero-enter hero-enter--2" id="hero-title">
        {content.hero.name}
      </h1>
      <p class="hero__statement hero-enter hero-enter--3">
        {content.hero.statement}
      </p>
      <p class="hero__intro hero-enter hero-enter--4">{content.hero.intro}</p>
      <div class="hero__actions hero-enter hero-enter--5">
        <a class="text-link text-link--strong" href="#work">
          {content.hero.primaryCta}
          <span aria-hidden="true">↓</span>
        </a>
        <a class="text-link" href="#about">
          {content.hero.secondaryCta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hero__role hero-enter hero-enter--5">
        <span>{content.hero.role}</span>
        <span>{content.hero.institution}</span>
      </div>
    </div>

    <figure class="hero__media hero-enter hero-enter--image" data-hero-image>
      <img
        src="/images/yichen-zhang.jpg"
        alt="Yichen Zhang in front of the Golden Gate Bridge"
        width="1536"
        height="2048"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{content.hero.photoCaption}</figcaption>
    </figure>

  </section>

  <section class="section section--about" id="about">
    <div class="section__label" data-reveal>
      <p>{content.about.kicker}</p>
    </div>
    <div class="about__body">
      <h2 class="display-heading" data-reveal>{content.about.heading}</h2>
      <div class="about__columns">
        <div class="about__copy" data-reveal>
          {content.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <aside class="margin-note" data-reveal>
          <p class="margin-note__label">{content.about.noteLabel}</p>
          <p>{content.about.note}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--research" id="research">
    <div class="research__intro">
      <p class="section-kicker section-kicker--light" data-reveal>
        {content.research.kicker}
      </p>
      <h2 class="display-heading display-heading--light" data-reveal>
        {content.research.heading}
      </h2>
      <p class="research__lead" data-reveal>{content.research.intro}</p>
    </div>

    <div class="research__list">
      {
        content.research.items.map((item) => (
          <article class="research-item" data-reveal>
            <span class="research-item__index">{item.index}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--work" id="work">
    <div class="work__heading">
      <div>
        <p class="section-kicker" data-reveal>{content.work.kicker}</p>
        <h2 class="display-heading" data-reveal>{content.work.heading}</h2>
      </div>
      <p class="work__intro" data-reveal>{content.work.intro}</p>
    </div>

    <div class="project-list">
      {
        content.work.projects.map((project) => (
          <article class="project" data-reveal>
            <span class="project__index">{project.index}</span>
            <div class="project__main">
              <p class="project__field">{project.field}</p>
              <h3>{project.title}</h3>
              <p class="project__description">{project.description}</p>
            </div>
            <div class="project__result">
              <p>{project.result}</p>
              {project.href && (
                <a href={project.href} target="_blank" rel="noreferrer">
                  <span>{project.linkLabel ?? content.work.viewProject}</span>
                  <span class="project__arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--journey" id="journey">
    <div class="journey__heading">
      <p class="section-kicker" data-reveal>{content.journey.kicker}</p>
      <h2 class="display-heading" data-reveal>{content.journey.heading}</h2>
    </div>

    <div class="journey__body">
      <p class="journey__label" data-reveal>{content.journey.educationLabel}</p>
      <div class="timeline">
        {
          content.journey.experiences.map((experience) => (
            <article class="timeline__item" data-reveal>
              <span class="timeline__year">{experience.years}</span>
              <div>
                <h3>{experience.institution}</h3>
                <p>{experience.degree}</p>
              </div>
              <span class="timeline__place">{experience.place}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <p class="section-kicker section-kicker--light" data-reveal>
      {content.contact.kicker}
    </p>
    <div class="contact__body">
      <h2 data-reveal>{content.contact.heading}</h2>
      <div class="contact__action" data-reveal>
        <p>{content.contact.intro}</p>
        <a href="mailto:yz10759@nyu.edu">
          <span>{content.contact.email}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <p>© {new Date().getFullYear()} Yichen Zhang</p>
  <p>{content.footer.note}</p>
  <div class="footer__links">
    <a href="https://github.com/JarvisZhang24" target="_blank" rel="noreferrer">GitHub</a>
    <a
      href="https://www.linkedin.com/in/yichen-zhang-a0077b2b3"
      target="_blank"
      rel="noreferrer">LinkedIn</a
    >
    <a href="#main">{content.footer.backToTop} ↑</a>
  </div>
</footer>
