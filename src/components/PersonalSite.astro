---
import { formatDate, getPosts, postPath } from "../data/blog";
import { profile, type PageContent } from "../data/site";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
const mailto = `mailto:${profile.email}`;

const recentPosts = (await getPosts(content.locale)).slice(0, 3);
const blogPath = content.locale === "en" ? "/blog/" : "/zh/blog/";

// Section numbers are derived so optional sections cannot knock them out of order.
const present = [
  "about",
  "research",
  "projects",
  "writing",
  ...(content.publications.items.length > 0 ? ["publications"] : []),
  "education",
  "toolkit",
  "contact",
];
const index = Object.fromEntries(
  present.map((key, i) => [key, String(i + 1).padStart(2, "0")]),
) as Record<string, string>;
---

<SiteHeader content={content} />

<main id="main">
  <section class="intro" aria-labelledby="intro-name">
    <div class="intro__field" aria-hidden="true"></div>

    <div class="intro__identity">
      <div class="avatar" aria-hidden="true">
        {
          profile.portrait ? (
            <img
              src={profile.portrait}
              alt=""
              width="96"
              height="96"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <span>{content.profile.monogram}</span>
          )
        }
      </div>

      <div class="intro__lines">
        <p class="mono-label intro__role">
          <span>{content.profile.role}</span>
          <span class="dot" aria-hidden="true">/</span>
          <span>{content.profile.affiliation}</span>
        </p>
        <h1 class="intro__name" id="intro-name">{content.profile.name}</h1>
      </div>
    </div>

    <p class="intro__tagline">{content.profile.tagline}</p>

    <p class="status">
      <span class="status__pulse" aria-hidden="true"></span>
      {content.profile.status}
    </p>

    <ul class="channels">
      <li>
        <a href={mailto}>{content.profile.emailLabel}</a>
      </li>
      <li>
        <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
      </li>
      <li>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      </li>
      {
        profile.scholar && (
          <li>
            <a href={profile.scholar} target="_blank" rel="noreferrer">
              {content.profile.scholarLabel}
            </a>
          </li>
        )
      }
      {
        profile.cv && (
          <li>
            <a href={profile.cv} target="_blank" rel="noreferrer">
              {content.profile.cvLabel}
            </a>
          </li>
        )
      }
    </ul>

    <dl class="facts">
      {
        content.profile.facts.map((fact) => (
          <div class="facts__item">
            <dt class="mono-label">{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="section__head" data-reveal>
      <span class="section__index" aria-hidden="true">{index.about}</span>
      <h2 class="section__title" id="about-title">{content.sections.about}</h2>
      <span class="section__rule" aria-hidden="true"></span>
    </div>
    <div class="prose" data-reveal>
      {content.profile.bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section" id="research" aria-labelledby="research-title">
    <div class="section__head" data-reveal>
      <span class="section__index" aria-hidden="true">{index.research}</span>
      <h2 class="section__title" id="research-title">{content.sections.research}</h2>
      <span class="section__rule" aria-hidden="true"></span>
    </div>
    <p class="section__lead" data-reveal>{content.research.lead}</p>

    <ol class="areas">
      {
        content.research.areas.map((area) => (
          <li class="area" data-reveal>
            <span class="area__index" aria-hidden="true">
              {area.id}
            </span>
            <div class="area__body">
              <h3 class="area__title">{area.title}</h3>
              <p class="area__text">{area.description}</p>
              <ul class="tags">
                {area.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="section__head" data-reveal>
      <span class="section__index" aria-hidden="true">{index.projects}</span>
      <h2 class="section__title" id="projects-title">{content.sections.projects}</h2>
      <span class="section__rule" aria-hidden="true"></span>
    </div>
    <p class="section__lead" data-reveal>{content.projects.lead}</p>

    <div class="projects">
      {
        content.projects.items.map((project) => (
          <article class="project" data-reveal>
            <div class="project__head">
              <span class="project__index" aria-hidden="true">
                {project.id}
              </span>
              <div class="project__naming">
                <h3 class="project__title">{project.title}</h3>
                <p class="mono-label project__field">{project.field}</p>
              </div>
              {project.href && (
                <a
                  class="project__link"
                  href={project.href}
                  target="_blank"
                  rel="noreferrer"
                >
                  <span>{project.linkLabel ?? content.projects.viewProject}</span>
                  <span class="arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              )}
            </div>
            <p class="project__desc">{project.description}</p>
            <p class="project__outcome">{project.outcome}</p>
            <ul class="tags">
              {project.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" id="writing" aria-labelledby="writing-title">
    <div class="section__head" data-reveal>
      <span class="section__index" aria-hidden="true">
        {index.writing}
      </span>
      <h2 class="section__title" id="writing-title">
        {content.sections.writing}
      </h2>
      <span class="section__rule" aria-hidden="true" />
    </div>
    <p class="section__lead" data-reveal>
      {content.blog.homeLead}
    </p>

    {
      recentPosts.length > 0 ? (
        <ol class="post-list post-list--compact">
          {recentPosts.map((post) => (
            <li class="post-item" data-reveal>
              <a href={postPath(post, content.locale)}>
                <time class="mono-label post-item__date" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date, content.locale)}
                </time>
                <div class="post-item__body">
                  <h3 class="post-item__title">
                    {post.data.title}
                    {post.data.draft && (
                      <span class="badge">{content.blog.draftLabel}</span>
                    )}
                  </h3>
                </div>
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <div class="blog-empty blog-empty--compact" data-reveal>
          <p>{content.blog.empty}</p>
        </div>
      )
    }

    <a class="section__more" href={blogPath} data-reveal>
      <span>{content.blog.viewAll}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </section>

  {
    content.publications.items.length > 0 && (
      <section class="section" id="publications" aria-labelledby="publications-title">
        <div class="section__head" data-reveal>
          <span class="section__index" aria-hidden="true">
            {index.publications}
          </span>
          <h2 class="section__title" id="publications-title">
            {content.sections.publications}
          </h2>
          <span class="section__rule" aria-hidden="true" />
        </div>
        <ol class="publications">
          {content.publications.items.map((item) => (
            <li class="publication" data-reveal>
              <p class="publication__authors">{item.authors}</p>
              <p class="publication__title">
                {item.href ? (
                  <a href={item.href} target="_blank" rel="noreferrer">
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </p>
              <p class="mono-label publication__venue">{item.venue}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="section" id="education" aria-labelledby="education-title">
    <div class="section__head" data-reveal>
      <span class="section__index" aria-hidden="true">{index.education}</span>
      <h2 class="section__title" id="education-title">{content.sections.education}</h2>
      <span class="section__rule" aria-hidden="true"></span>
    </div>
    <p class="section__lead" data-reveal>{content.education.lead}</p>

    <ol class="timeline">
      {
        content.education.items.map((item) => (
          <li class="timeline__item" data-reveal>
            <span class="mono-label timeline__years">{item.years}</span>
            <div class="timeline__body">
              <h3 class="timeline__institution">{item.institution}</h3>
              <p class="timeline__degree">{item.degree}</p>
            </div>
            <span class="mono-label timeline__place">{item.place}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" id="toolkit" aria-labelledby="toolkit-title">
    <div class="section__head" data-reveal>
      <span class="section__index" aria-hidden="true">{index.toolkit}</span>
      <h2 class="section__title" id="toolkit-title">{content.sections.toolkit}</h2>
      <span class="section__rule" aria-hidden="true"></span>
    </div>

    <div class="toolkit">
      {
        content.toolkit.groups.map((group) => (
          <div class="toolkit__group" data-reveal>
            <p class="mono-label toolkit__label">{group.label}</p>
            <ul class="tags">
              {group.items.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--contact" id="contact" aria-labelledby="contact-title">
    <div class="section__head" data-reveal>
      <span class="section__index" aria-hidden="true">{index.contact}</span>
      <h2 class="section__title" id="contact-title">{content.sections.contact}</h2>
      <span class="section__rule" aria-hidden="true"></span>
    </div>

    <p class="section__lead" data-reveal>{content.contact.lead}</p>

    <a class="contact-card" href={mailto} data-reveal>
      <span class="mono-label">{content.contact.cta}</span>
      <span class="contact-card__address">{profile.email}</span>
      <span class="arrow" aria-hidden="true">↗</span>
    </a>
  </section>
</main>

<SiteFooter content={content} />
