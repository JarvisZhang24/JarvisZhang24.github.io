---
import type { PageContent } from "../data/site";

interface Props {
  content: PageContent;
  /** Overrides the language switch target on pages other than the homepage. */
  alternatePath?: string;
}

const { content, alternatePath = content.alternatePath } = Astro.props;

const home = content.locale === "en" ? "/" : "/zh/";
const blogPath = content.locale === "en" ? "/blog/" : "/zh/blog/";

// Section links are in-page anchors on the homepage and cross-page links elsewhere.
const onHome = Astro.url.pathname === home;
const section = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
const inBlog = Astro.url.pathname.startsWith(blogPath);
---

<a class="skip-link" href="#main">{content.nav.skip}</a>

<header class="masthead">
  <div class="masthead__inner">
    <a class="brand" href={home} aria-label={content.profile.name}>
      <span class="brand__mark" aria-hidden="true">{content.profile.monogram}</span>
      <span class="brand__name">{content.profile.name}</span>
    </a>

    <nav class="masthead__nav" aria-label="Sections">
      <a href={section("about")}>{content.nav.about}</a>
      <a href={section("research")}>{content.nav.research}</a>
      <a href={section("projects")}>{content.nav.projects}</a>
      <a href={blogPath} aria-current={inBlog ? "page" : undefined}>
        {content.nav.writing}
      </a>
      <a href={section("contact")}>{content.nav.contact}</a>
    </nav>

    <div class="masthead__tools">
      <a
        class="masthead__blog-link"
        href={blogPath}
        aria-current={inBlog ? "page" : undefined}
      >
        {content.nav.writing}
      </a>
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label={content.nav.theme}
        title={content.nav.theme}
      >
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <g class="theme-toggle__sun">
            <circle cx="10" cy="10" r="3.6"></circle>
            <path
              d="M10 1.4v2.1M10 16.5v2.1M18.6 10h-2.1M3.5 10H1.4M16.08 3.92l-1.49 1.49M5.41 14.59l-1.49 1.49M16.08 16.08l-1.49-1.49M5.41 5.41L3.92 3.92"
            ></path>
          </g>
          <path
            class="theme-toggle__moon"
            d="M16.2 12.4A6.9 6.9 0 017.6 3.8a6.9 6.9 0 108.6 8.6z"></path>
        </svg>
      </button>

      <a
        class="lang-switch"
        href={alternatePath}
        lang={content.locale === "en" ? "zh-CN" : "en"}
        hreflang={content.locale === "en" ? "zh-CN" : "en"}
        data-language-link
        data-language={content.locale === "en" ? "zh" : "en"}
      >
        {content.alternateLabel}
      </a>
    </div>
  </div>
  <span class="masthead__progress" aria-hidden="true"></span>
</header>
