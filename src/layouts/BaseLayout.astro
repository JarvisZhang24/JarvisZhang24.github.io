---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/600.css";
// Noto Serif SC ships several hundred CJK subsets; it is imported by the
// Chinese page alone so the English page does not carry those @font-face rules.
import { profile } from "../data/site";
import "../styles/global.css";

interface Props {
  lang: string;
  title: string;
  description: string;
  canonicalPath: string;
  alternatePath: string;
}

const { lang, title, description, canonicalPath, alternatePath } = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const alternateUrl = new URL(alternatePath, Astro.site);
const alternateLang = lang.startsWith("zh") ? "en" : "zh-CN";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Yichen Zhang",
  url: "https://jarvis-zhang.com",
  jobTitle: "Research Student",
  email: `mailto:${profile.email}`,
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "Osaka University",
  },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "New York University" },
    { "@type": "CollegeOrUniversity", name: "Beijing Jiaotong University" },
  ],
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: [
    "Generative AI for Drug Discovery",
    "Biological Foundation Models",
    "Multimodal Learning",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fcfcfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0d12" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta name="author" content="Yichen Zhang" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href="https://jarvis-zhang.com/" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Yichen Zhang" />
    <meta property="og:locale" content={lang.startsWith("zh") ? "zh_CN" : "en_US"} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>

    <script is:inline>
      // Resolve the colour theme before first paint to avoid a flash.
      (function () {
        var root = document.documentElement;
        try {
          var stored = localStorage.getItem("theme");
          root.dataset.theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        } catch (error) {
          root.dataset.theme = "light";
        }
        root.classList.add("has-js");
      })();
    </script>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    ></script>
  </head>
  <body>
    <slot />

    <script>
      const root = document.documentElement;
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      requestAnimationFrame(() => root.classList.add("is-ready"));

      /* Colour theme -------------------------------------------------------- */

      const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

      document
        .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const next = root.dataset.theme === "dark" ? "light" : "dark";
            root.dataset.theme = next;
            try {
              localStorage.setItem("theme", next);
            } catch (error) {
              /* storage unavailable — the choice just won't persist */
            }
          });
        });

      systemDark.addEventListener("change", (event) => {
        let stored: string | null = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (error) {
          /* ignore */
        }
        if (!stored) root.dataset.theme = event.matches ? "dark" : "light";
      });

      /* Scroll reveal ------------------------------------------------------- */

      const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");

      if (prefersReducedMotion) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.06 },
        );

        revealItems.forEach((item) => revealObserver.observe(item));
      }

      /* Reading progress ---------------------------------------------------- */

      if (!prefersReducedMotion) {
        let ticking = false;

        const updateProgress = () => {
          const scrollable = root.scrollHeight - window.innerHeight;
          const progress =
            scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
          root.style.setProperty("--page-progress", progress.toString());
          ticking = false;
        };

        updateProgress();
        window.addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(updateProgress);
          },
          { passive: true },
        );
      }

      /* Language preference ------------------------------------------------- */

      document
        .querySelectorAll<HTMLAnchorElement>("[data-language-link]")
        .forEach((link) => {
          link.addEventListener("click", () => {
            const language = link.dataset.language;
            if (!language) return;
            try {
              localStorage.setItem("preferred-language", language);
            } catch (error) {
              /* ignore */
            }
          });
        });
    </script>
  </body>
</html>
